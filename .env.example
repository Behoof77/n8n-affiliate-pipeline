# Copy to .env and fill in values. Used by docker-compose.yml and deploy.sh.

# Public FQDN for n8n (DuckDNS A record -> server IP)
N8N_DOMAIN=agenticflow1.duckdns.org

# Random 32+ char string; encrypts n8n credentials at rest.
# Generate: openssl rand -hex 32
N8N_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# n8n owner mailbox that receives pipeline approval emails
NOTIFY_EMAIL=you@example.com

# DuckDNS (only needed if using deploy.sh to create the record)
DUCKDNS_TOKEN=
DUCKDNS_NAME=agenticflow1

# Scraper tuning
MEESHO_QUERIES=women kurti,mobile cover,kitchen organizer
SCRAPER_TOP_N=5
# strict = exclude products whose 1-2 star share cannot be verified (spec default)
RETURN_RISK_MODE=strict

# Renderer
RENDERER_VOICE=hi-IN-SwaraNeural
# edge = TTS word boundaries (default, no RAM cost); whisper = faster-whisper tiny int8
RENDERER_STT=edge
